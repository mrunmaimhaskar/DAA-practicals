Binary Search 
CODE:
a = sorted(list(map(int, input().split())))
key = int(input())

l = 0
r = len(a) - 1

while l <= r:
    m = (l + r) // 2

    if a[m] == key:
        print("Found")
        break
    elif key < a[m]:
        r = m - 1
    else:
        l = m + 1
else:
    print("Not Found")

OUTPUT:
10 20 30 40 50 
60
Not Found


Bubble Sort 
CODE:
a = list(map(int, input().split()))

for i in range(len(a)):
    for j in range(len(a) - 1 - i):
        if a[j] > a[j + 1]:
            a[j], a[j + 1] = a[j + 1], a[j]

print(a)

OUTPUT:
20 30 40 
[20, 30, 40]



Selection Sort 
CODE:
a = list(map(int, input().split()))

for i in range(len(a)):
    m = i

    for j in range(i + 1, len(a)):
        if a[j] < a[m]:
            m = j

    a[i], a[m] = a[m], a[i]

print(a)

OUTPUT:
20 50 60 30
[20, 30, 50, 60]


Insertion Sort 
CODE:
a = list(map(int, input().split()))

for i in range(1, len(a)):
    key = a[i]
    j = i - 1

    while j >= 0 and a[j] > key:
        a[j + 1] = a[j]
        j -= 1
   a[j + 1] = key
print(a)
OUTPUT:
80 90 10 30 50
[10, 30, 50, 80, 90]

