# Linked List Insertion
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


head = Node(10)
head.next = Node(20)
head.next.next = Node(30)

temp = head

while temp:
    print(temp.data, end=" ")
    temp = temp.next

OUTPUT:
[10, 20]
Pop: 20
[10]
10 20 30 
